{
  "name": "netblk Linux / ublk",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/netblk,type=bind",
  "workspaceFolder": "/workspaces/netblk",
  "remoteUser": "root",
  "privileged": true,
  "init": true,
  "runArgs": [
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--ulimit=memlock=-1:-1"
  ],
  "mounts": [
    "source=/dev,target=/dev,type=bind",
    "source=/lib/modules,target=/lib/modules,type=bind,readonly",
    "source=${localWorkspaceFolderBasename}-target-linux,target=/workspaces/netblk/target,type=volume",
    "source=${localWorkspaceFolderBasename}-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=${localWorkspaceFolderBasename}-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],
  "postCreateCommand": "cargo fetch --locked",
  "postStartCommand": "modprobe ublk_drv && bash .devcontainer/check-tools.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "skellock.just"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
